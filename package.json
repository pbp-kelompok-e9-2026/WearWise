{
  "name": "wearfit-frontend",
  "private": true,
  "scripts": {
    "build": "node scripts/build-frontend.mjs",
    "build:css": "tailwindcss -i static/src/worth_to_buy.css -o static/css/worth_to_buy.css --minify && tailwindcss -i static/src/analyzer_workspace.css -o static/css/analyzer_workspace.css --minify",
    "watch:css": "tailwindcss -i static/src/worth_to_buy.css -o static/css/worth_to_buy.css --watch",
    "watch:workspace": "tailwindcss -i static/src/analyzer_workspace.css -o static/css/analyzer_workspace.css --watch"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.25.0",
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  },
  "dependencies": {
    "htmx.org": "2.0.11"
  }
}
